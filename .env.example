# Скопируйте этот файл в .env.local и подставьте свои значения.
# .env.local не попадает в git. На Vercel те же переменные задаются
# в Settings → Environment Variables.

# ---------- ИИ ----------
# openai, gemini или openrouter
AI_PROVIDER=openai
# Ключ OpenAI (sk-…): https://platform.openai.com/api-keys
# Ключ Gemini (AIza…, бесплатно): https://aistudio.google.com/apikey
# Ключ OpenRouter (sk-or-…): https://openrouter.ai/keys — с ним AI_PROVIDER определяется сам
AI_API_KEY=
# Необязательно. По умолчанию: gpt-5-mini для openai, gemini-3.8-flash для gemini,
# openai/gpt-5-mini для openrouter (там модель пишется с владельцем: google/gemini-3.8-flash).
# Модель должна поддерживать Structured Outputs.
AI_MODEL=
# Старые имена OPENAI_API_KEY и OPENAI_MODEL тоже работают.

# Демо-режим без ИИ: true — OpenAI не вызывается, материалы берутся из
# samples/mock-materials.json. Включается и сам, если нет ключа ИИ.
MOCK_GENERATION=false

# ---------- Хранилище ----------
# local — JSON-файлы в data/lessons/ (для разработки);
# supabase — база Supabase (для деплоя; на Vercel local не работает).
# Если не задано: supabase при наличии SUPABASE_URL, иначе local.
STORAGE=local
# Только для STORAGE=supabase. Ключ — СЕКРЕТНЫЙ (secret / service_role),
# используется только на сервере. Никогда не называйте его NEXT_PUBLIC_*.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Вход ментора ----------
# Пароль для /lessons, редактора и API. Без него при `npm run dev` всё открыто,
# а в продакшене страницы ментора закрыты, пока пароль не задан.
MENTOR_PASSWORD=
# Необязательно: отдельный ключ подписи cookie (случайная строка 32+ символа).
SESSION_SECRET=

# ---------- Лимиты генерации (защита баланса OpenAI) ----------
GENERATION_LIMIT_PER_HOUR=30
GENERATION_LIMIT_PER_MINUTE=3
